// python yolo based gitignore

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
*.egg-info/
.installed.cfg
*.egg

# PyInstaller
#  Usually these files are written by a python script from a template
#  before PyInstaller builds the exe, so as to inject date/other infos into it.
*.manifest
*.spec

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# Unit test / coverage reports
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
.hypothesis/

# Jupyter Notebook
.ipynb_checkpoints

# pyenv
.python-version

# pipenv
Pipfile.lock

# pytest
.cache/

# mypy
.mypy_cache/
.dmypy.json
dmypy.json

# Pyre type checker
.pyre/

# Cython debug symbols
cython_debug/

# vscode
.vscode/

# Local environments
env/
venv/
ENV/
env.bak/
venv.bak/
.venv/

# YOLO output folders (common for YOLO)
runs/
exp/
exp*/  # sometimes YOLO creates numbered folders

# YOLOv5 specific cache
__pycache__/
*.pyc
*.pyo

# Mac OS files
.DS_Store

# System Files
Thumbs.db

# Logs
*.log

# Model files (you may want to keep these outside version control)
*.pt
*.pth
*.weights
*.onnx
*.tflite
*.engine
*.pb
*.task

# Media/large files for testing/outputs
*.mp4
*.avi
*.mov
*.mkv
*.jpg
*.jpeg
*.png
*.bmp
*.webp

# If using FaceLandmarker, model assets
face_landmarker.task

.env
opencode.json
haarcascade_frontalface_default.xml